<!DOCTYPE html>
<html>

<head>
    <title>Fog IoT Monitoring Dashboard</title>
    <link rel="stylesheet" href="/static/style.css">
</head>

<body>

<h1>🌫 Fog Assisted Data Centre Monitoring</h1>


<div class="cards">

    <div class="card">
        <h3>Total Sensors</h3>
        <p id="totalSensors">0</p>
    </div>


    <div class="card alert">
        <h3>Active Alerts</h3>
        <p id="totalAlerts">0</p>
    </div>

</div>


<h2>🚨 Anomaly Alerts</h2>

<table>

<thead>
<tr>
<th>Sensor ID</th>
<th>Type</th>
<th>Value</th>
<th>Status</th>
</tr>
</thead>

<tbody id="alertTable">

</tbody>

</table>



<h2>📡 Sensor Data</h2>

<table>

<thead>
<tr>
<th>Sensor ID</th>
<th>Type</th>
<th>Value</th>
<th>Anomaly</th>
<th>Processed By</th>
</tr>
</thead>


<tbody id="sensorTable">

</tbody>

</table>


<script src="/static/script.js"></script>

</body>

</html>
